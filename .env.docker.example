# ---------------------------------------------------------------------------
# HolidayHub — Docker environment template
#
#   cp .env.docker.example .env
#   php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
#   # paste the output into APP_KEY below
#
# Secrets live in .env only. Never commit it, never bake it into an image.
# ---------------------------------------------------------------------------

APP_NAME=HolidayHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

# Set by the entrypoint only. Do not run migrations from every replica.
RUN_MIGRATIONS=false

PHP_CLI_SERVER_WORKERS=8
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: PostgreSQL ---------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=holidayhub
DB_USERNAME=holidayhub
DB_PASSWORD=holidayhub
DB_SSLMODE=prefer

POSTGRES_DB=holidayhub
POSTGRES_USER=holidayhub
POSTGRES_PASSWORD=holidayhub
POSTGRES_PORT=5432

# --- Cache / session / queue: Redis -----------------------------------------
# Not optional. The availability engine needs atomic Redis locks to prevent
# double-booking, which the database and file drivers cannot provide.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_NAME=default

# --- Mail -------------------------------------------------------------------
# Docker: mailpit (UI on http://localhost:8025)
# Production: real SMTP credentials.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@holidayhub.test"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

# --- Storage (S3 recommended once past a single node) -----------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Payments ---------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Keeps the NullPaymentGateway bound instead of real Stripe. MUST be false in
# production — while true, no money is ever charged.
BOOKING_TEST_MODE=true

# --- Frontend ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173
APP_PORT=8000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
