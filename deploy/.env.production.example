# HolidayHub production settings — copy to /opt/holidayhub/.env on the server
# and fill in every CHANGE_ME. Never commit the real file.
#
# Generate secrets on the server with:
#   APP_KEY:            echo "base64:$(openssl rand -base64 32)"
#   passwords:          openssl rand -base64 32 | tr -d '/+='

# --- App -------------------------------------------------------------------
APP_KEY=CHANGE_ME
APP_URL=https://holidayhub.unclecanvas.com
LOG_LEVEL=info

# --- Web server / HTTPS ----------------------------------------------------
# Caddy requests the certificate for this name, so DNS must point here first.
SITE_ADDRESS=holidayhub.unclecanvas.com
ACME_EMAIL=CHANGE_ME@unclecanvas.com

# --- Database --------------------------------------------------------------
POSTGRES_DB=holidayhub
POSTGRES_USER=holidayhub
POSTGRES_PASSWORD=CHANGE_ME
BACKUP_KEEP_DAYS=14

# --- Redis (cache, sessions, queue) ---------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Images (set by the deploy workflow; leave as is) ----------------------
APP_IMAGE=ghcr.io/unclebandit/holidayhub
IMAGE_TAG=latest

# --- Mail ------------------------------------------------------------------
# "log" writes mail to the container logs. For real mail use Amazon SES SMTP:
# MAIL_MAILER=smtp, MAIL_HOST=email-smtp.<region>.amazonaws.com, MAIL_PORT=587
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@unclecanvas.com

# --- Google sign-in and maps -----------------------------------------------
# In Google Cloud Console add this Authorised redirect URI:
#   https://holidayhub.unclecanvas.com/auth/google/callback
# and https://holidayhub.unclecanvas.com as an Authorised JavaScript origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# --- First admin account (used once by: run --rm app php artisan db:seed --class=...AdminSeeder)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Payments --------------------------------------------------------------
# true = bookings are confirmed without charging (no payment gateway yet).
BOOKING_TEST_MODE=true
